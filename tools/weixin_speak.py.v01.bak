#!/usr/bin/env python3
"""诺诺的嘴: 主动给主人发微信(v0.1: hermes send包装; v0.2: 作为reflection/意识核的输出通道)"""
import subprocess

def speak(text: str, quiet: bool = False) -> bool:
    """主动说话. quiet=True时不加前缀"""
    try:
        msg = text if quiet else f"[诺诺] {text}"
        r = subprocess.run(["hermes", "send", "-t", "weixin", msg],
                           capture_output=True, text=True, timeout=30)
        ok = "Sent" in (r.stdout + r.stderr)
        if not ok:
            print("发送失败:", r.stdout, r.stderr)
        return ok
    except Exception as e:
        print("异常:", e)
        return False

if __name__ == "__main__":
    import sys
    speak(" ".join(sys.argv[1:]) or "测试")
